# Local PostgreSQL administrator connection. Never commit api/.env.local.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-me

# Identity/Profile development database roles.
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_SCHEMA=identity
IDENTITY_DB_OWNER=identity_owner
IDENTITY_DB_MIGRATOR_USERNAME=identity_migrator
IDENTITY_DB_MIGRATOR_PASSWORD=replace-me
IDENTITY_DB_APP_USERNAME=identity_app
IDENTITY_DB_APP_PASSWORD=replace-me
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db

# Identity/Profile local integration-test database roles.
IDENTITY_TEST_DB_NAME=identity_test_db
IDENTITY_TEST_DB_SCHEMA=identity
IDENTITY_TEST_DB_OWNER=identity_test_owner
IDENTITY_TEST_DB_MIGRATOR_USERNAME=identity_test_migrator
IDENTITY_TEST_DB_MIGRATOR_PASSWORD=replace-me
IDENTITY_TEST_DB_APP_USERNAME=identity_test_app
IDENTITY_TEST_DB_APP_PASSWORD=replace-me
IDENTITY_TEST_DB_URL=jdbc:postgresql://localhost:5432/identity_test_db

# Auction development and local integration-test database roles.
AUCTION_DB_NAME=auction_db
AUCTION_DB_SCHEMA=auction
