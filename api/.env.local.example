AUCTION_TEST_DB_OWNER=auction_test_owner
AUCTION_TEST_DB_MIGRATOR_USERNAME=auction_test_migrator
AUCTION_TEST_DB_MIGRATOR_PASSWORD=replace-me
AUCTION_TEST_DB_APP_USERNAME=auction_test_app
